WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct-fp8   # optional; auto-picked from the live catalog
ADMIN_EMAIL=admin@nagarnetra.app
ADMIN_PASSWORD=change-me-please
SECRET_KEY=
SEED_DEMO=true
